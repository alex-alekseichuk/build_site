#!/bin/bash

cd $(dirname $0)
cdir=$(pwd)
cd ..
pdfdir="$(pwd)/pdf_images/"

mdir=$(python export_svg.py $1)
cd $mdir

act=$(cat active)

i=1
while (( i <= ${#act} ))
do
   char=$(expr substr "$act" $i 1)
   if [ $char = '1' ]; then
       fpng="`printf '%04d' $i`.png"
       cp "${pdfdir}${1}/${i}.png" ./$fpng
       fsvg="${i}.svg"
       if [ -f $fsvg ]; then
	   fm="${i}m.png"
	   rsvg-convert -a $fsvg -o $fm -w 690
	   composite -gravity NorthWest $fm $fpng $fpng
	   rm $fsvg $fm
       fi
   fi
   (( i += 1 ))
done

convert *.png $1.pdf

mv *.pdf $cdir
cd $cdir
rm -rf $mdir
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head profile="http://selenium-ide.openqa.org/profiles/test-case">
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<link rel="selenium.base" href="http://crunch.ahinea.com:3000/" />
<title>01email-document</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">01email-document</td></tr>
</thead><tbody>
<tr>
	<td>open</td>
	<td>/login</td>
	<td></td>
</tr>
<tr>
	<td>type</td>
	<td>username</td>
	<td>ieg</td>
</tr>
<tr>
	<td>type</td>
	<td>password</td>
	<td>__IEG_TEST_PASSWORD__</td> <!-- replace with the test account's current password before running -->
</tr>
<tr>
	<td>clickAndWait</td>
	<td>//input[@value='Login']</td>
	<td></td>
</tr>
<tr>
	<td>assertTitle</td>
	<td>home</td>
	<td></td>
</tr>
<tr>
	<td>echo</td>
	<td>Logged as ieg successfully</td>
	<td></td>
</tr>
<tr>
	<td>clickAndWait</td>
	<td>link=New Package</td>
	<td></td>
</tr>
<!--Searching a product-->
<tr>
	<td>type</td>
	<td>q</td>
	<td>concrete</td>
</tr>
<tr>
	<td>clickAndWait</td>
	<td>//input[@value='SEARCH']</td>
	<td></td>
</tr>
<!--Selecting a document-->
<tr>
	<td>clickAndWait</td>
	<td>//table[@class=&quot;basic t-adv&quot;]//tr[2]/td/a</td>
	<td></td>
</tr>
<tr>
	<td>click</td>
	<td>//input[@name=&quot;chkItem&quot;][1]</td>
	<td></td>
</tr>
<tr>
	<td>waitForTextPresent</td>
	<td>1 Product</td>
	<td></td>
</tr>
<!--Sending the document-->
<tr>
	<td>clickAndWait</td>
	<td>link=Send Package</td>
	<td></td>
</tr>
<tr>
	<td>type</td>
	<td>to_search_input</td>
	<td>kalyansky@gmail.com</td>
</tr>
<tr>
	<td>clickAndWait</td>
	<td>//input[@value='Send']</td>
	<td></td>
</tr>
<tr>
	<td>assertTitle</td>
	<td>Sent Messages</td>
	<td></td>
</tr>
<!--Logging out-->
<tr>
	<td>clickAndWait</td>
	<td>//img[@alt='BuildSite']</td>
	<td></td>
</tr>
<tr>
	<td>click</td>
	<td>link=Logout</td>
	<td></td>
</tr>
<tr>
	<td>echo</td>
	<td>Logged out successfully</td>
	<td></td>
</tr>

</tbody></table>
</body>
</html>

[% PROCESS "error.tt" %]
<form action="/login" method="post">
	<div class="row">
		<label for="username">Username</label>
		<input type="text" name="login" id="username" value="" />
	</div>

	<div class="row">
		<label for="password">Password</label>
		<input type="password" name="password" id="password" value="" />
	</div>

	<p>
	  [% USE HTML %]
	  <input type="hidden" name="goto" value="[% HTML.escape( c.req.param('goto') ) %]"/>
	  <input type="submit" class="btn" value="Login" />
  	</p>
</form>

<p>Forget your Username or Password? Need technical support?<br />Email <a href="mailto:support@buildsite.com">support@buildsite.com</a> or call (888) 717-8665 or (888) 717-TOOL.</p>


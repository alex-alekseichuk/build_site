[%
	USE url;
    
    PROCESS 'user_date.tt';
	
    message_title = message.subject || "Message without subject";
	page_title =  message_title _ " - message details";
	# breadcrumbs
	crumb( "Messages", "/messages/" );
	crumb( "All Messages", "/messages/list" );
	crumb( message_title );

	caption = "View Message";
	caption_class = "message";
-%]

[%- IF message.package.has_upgrades -%]
<script type="text/javascript" language="javascript">
// TODO: upgrade dialog
</script>
[%- END -%]

<form method="post" action="/messages/forward" id="frmCompose">
<p><a href="/messages/blank">New Message</a> [%- IF has_current_message -%] &nbsp;|&nbsp; <a href="/messages/current">Current Message</a>[%- END -%]</p>

<div id="action-bar">
	<input type="hidden" name="message_id" value="[% message.message_id %]" />
	<input class="button" type="submit" value="Resend" />
</div>

[% display_thumb = package && package.package_toc_type ? 1 : 0 %]

<div id="divMessage"[% IF display_thumb %] style="float:left; width:620px;"[% END %]>
<table class="basic vert">
        <tr><th>From:</th><td>[% message.sender.name %]</td></tr>
        [%- PROCESS to_contacts.tt message show_status=1, display_table_tags=1 -%]
        <tr><th>Date:</th><td>
        [% IF message.time_sent %]
            [% user_date( message.time_sent) %]
        [% END %]
    </td></tr>
    <tr><th>Subject:</th><td>[% message.subject %]</td></tr>
    <tr>
    [% IF message.body %]
    <td colspan="2">
        <div><strong>Message:</strong></div>
        <div class="b-mess-body">[% message.body | html | ext_url | html_line_break %]</div>
    </td>
    </tr>
    [% END %]
</table>

</div>

[% IF display_thumb %]
	<div id="divThumb" style="float:right; padding-bottom:2em;">
	[%- IF package.package_toc_type -%]
	[% package.toc_item_label %]<br />
	<a href="/jstoc/toc_pdf?id=[% package.id %]"><img width="250" style="padding:3px;border:1px solid #ccc;width:250px;height:324px;" src="/jstoc/toc_thumb?id=[% package.id %]&quirk=[% quirk %]" alt="TOC preview..." /></a>
	[%- END -%]
	</div>
	
	<div style="clear:both;"></div>
[% END %]

[% IF package && package.items %]
<!-- PACKAGE START -->
<div style="padding-bottom:5px;">Attachments:</div>

<div id="divItems">

[% IF send_package %]<input type="hidden" name="package_id" value="[% package.id %]" />[% END %]
<table class="basic">
<tr>
    <th>Name</th>
    <th style="text-align:right;">Size</th>
    <th style="text-align:right;">Pg</th>
</tr>
[% size = 0; pages = 0;%]
[%- IF package.package_toc_type -%]
<tr>
    <td>[% package.toc_item_label %]</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
</tr>
[%- END -%]
[%- FOREACH i = package.items -%]
<tr>
    <td><a target="_blank" href="[% i.document_id.download_url || i.file_id.download_url %]"><img class="ico" alt="" src="/images/icons/[% i.item_type %].gif" /></a>&nbsp;&nbsp;<a target="_blank" href="[% i.document_id.download_url || i.file_id.download_url %]">[% i.title %]</a></td>
    <td style="text-align:right;">[% i.file_size FILTER file_size %][% size = size + i.file_size %]</td>
    <td style="text-align:right;">[% IF i.is_faxable %][% i.page_count || "at least 1" %][% pages = pages + i.page_count %][% END %]</td>
</tr>
[%- END -%]
</table>
</div>
<!-- PACKAGE END -->
[%END%]
</form>

[% 
	USE url;
	page_title = obj ? "User details &mdash; " _ obj.login_id : "New user details";
	PROCESS 'admin/crumbs.tt' users = 1;

	crumb("New user") UNLESS obj;
	caption = "User Details &mdash; " _ ( obj.given_name ? obj.given_name _ " " _ obj.family_name : 'New user');
	caption_class = "preferences";
%]


[%- IF c.user.is_single_user -%]
	<p>You can edit your profile here or you can <a href="/settings/list?scope=user&scope_value=[% obj.user_id %]">manage your settings</a>.</p>
[%- ELSE -%]
[% IF obj %]

[% IF obj.user_id %]<p><a href="/settings/list?scope=user&scope_value=[% obj.user_id %]">Settings</a></p>
<form action="/admin/delete/user" id="delete_user" method="post" name="delete_user">
<input name="user_id" type="hidden" value="[% obj.user_id %]"/>
[% IF !obj.block_access %]<input name="delete" type="submit" value="Block User" />[% END %]
</form>[% END %]

[% END %]
[%- END-%]

[%- IF obj -%]

[%- ELSE -%]

<h2>New user</h2>

[%- END -%]

<div class="t-basic t-vert">[%- FormBuilder.render -%]</div>

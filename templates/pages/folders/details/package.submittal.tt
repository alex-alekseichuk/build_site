<link rel="stylesheet" type="text/css" href="/css/toc.css" />
<link rel="stylesheet" type="text/css" href="/css/jquery-autocomplete.css" />

<script src="/js/jquery.timers.js" type="text/javascript"></script>
<script src="/js/jquery.json.js" type="text/javascript"></script>
<script src="/js/jquery.tablednd.js" type="text/javascript"></script>
<script src="/js/toc.autocomplete.js" type="text/javascript"></script>
<script src="/js/toc.templates.js" type="text/javascript"></script>
<script src="/js/toc.js" type="text/javascript"></script>
<script type="text/javascript">
    var package_id = '[%- package.package_id -%]';
    var toc_columns = [% column_fields_JSON %];
    var toc_table = [% toc_table_JSON %];
</script>


[% PROCESS "folders/details/package._actions.tt" buttons = '
    <input type="button" id="action-preview" value="Preview Cover Page" redirect_new="/jstoc/toc_pdf?id=' _ item.file_id _ '" />
' %]
[% PROCESS "folders/details/package._header.tt" %]

<form id="package-details" class="file-details" method="post" action="/folders/saveall">
    <input type="hidden" name="file_id" value="[% item.file_id %]" />

    <p class="autosave-notice"></p>

    [% PROCESS "folders/details/file.details.tt" IF saved %]

    <div class="half">
[%
    USE String( meta_fields.size / 2 );
    half = String.format("%d");
    half = half + 1 IF meta_fields.size % 2;

    FOREACH f = meta_fields;
        name = f.name;
        val = meta_values.$name;

        PROCESS "input.tt" 
            type = f.type,
            name = f.name,  
            label = f.label,
        value = val,
        params = f
        ;

        half = half - 1;
        "</div><div class=\"half\">" IF half == 0;
    END 
%]
    </div><!-- half -->
</form>

<h3>Products and Documents Included</h3>
<div id="table-action-bar" class="table-action-bar"> 
    <p class="autosave-notice"></p>
    <input type="button" class="btn_toc_add" value="Add Row" />
    <input type="button" class="table-action-attach" value="Attach" />
    [% IF item.can_write(c.user) %]<input type="button" class="table-action-clear" value="Clear" /> [% END %]
    <input type="button" class="table-action-save" value="Save Changes" disabled="disabled" />

</div>

[% IF c.req.param("message") == 'items_order_changed' %]
    <p class="notice">Items order was automatically changed.</p>
[% END %]
<table id="toc" class="basic rich"></table>

<div id="table-action-bar2" class="table-action-bar" style="display:none;"> 
    <input type="button" class="btn_toc_add" value="Add Row" />
    <input type="button" class="table-action-attach" value="Attach" />
    [% IF item.can_write(c.user) %]<input type="button" class="table-action-clear" value="Clear" /> [% END %]
    <input type="button" class="table-action-save" value="Save Changes" disabled="disabled" /> 
</div>

<div> 
    [% toc_footer_html %]
</div>

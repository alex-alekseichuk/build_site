[%-
	USE url;

	PROCESS 'inc/unix_time.tt';
	PROCESS 'folders/crumbs.tt';

	page_title = "Folder details &ndash; " _ item.file_title;
	caption = "Folder Details";
	caption_class = "folder";
	can_write = item.can_write( c.user );
%]


<div id="action-bar">
	<input type="button" id="action-copy" value="Copy / Move" />
<input type="button" id="action-delete" [% IF !can_write %] disabled="disabled" title="You have not enough permissions to delete this file." [% ELSE %][% IF has_items %] disabled="disabled" title="You cannot delete the folder because there are some items inside."[% END %][% END %] value="Delete" />
</div>

<form class="file-details" method="post" enctype="multipart/form-data" action="/folders/save">
	<input name="file_id" id="file_id" type="hidden" value="[% item.file_id %]" />

	[% PROCESS "folders/details/file.details.tt" name_label = "Name" %]
	[% PROCESS "folders/details/save.button.tt" %]
</form>

<table style="margin-left:10px;">
	<col width="110" />
	<tr>
		<th>Created by</th>
		<td>[% item.creator_user.name %]</td>
	</tr>

	<tr>
		<th></th>
		<td><a href="[% url('/folders/list', id = item.id) %]">File Listing</a></td>
	</tr>
</table>
</div>
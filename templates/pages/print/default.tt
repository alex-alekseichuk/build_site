[%-
    USE url;
    no_sidebar = item && current_package && (item.file_class == 'archive') && current_package.id == item.file_id;

    PROCESS 'inc/unix_time.tt';

    PROCESS 'folders/crumbs.tt' isprint = 1;

    page_title = 'Print' _ " &ndash; " _ (item.file_title ? item.file_title : 'New Package');
    caption = "Print Center";
    caption_class = "print";
%]

[%- IF (item.file_class == 'archive') -%]
[% force_print = c.req.param('force_print') %]
[% PROCESS 'print/print.tt' %]

<link rel="stylesheet" type="text/css" href="/css/print.css" />
<script src="/js/jquery.tablednd.js" type="text/javascript"></script>

<table class="basic" id="tablePrintItems">
<tr class="nodrop">
  <th class="col-ico"></th>
  <th colspan="2">Title</th>
  <th class="ie-only">Print</th>
</tr>
<tr class="nodrop">
  <td>&nbsp;</td>
  <td colspan="2">
    [%- IF item.package_toc_type -%]
      <a href="[% url('/jstoc/toc_pdf', id = item.id) %]"
             title="Download PDF">Table of Contents: [% item.package_toc_type %]</a>
        (<a href="[% url('/jstoc/toc_html', id = item.id) %]">html</a>)
    [%- ELSE -%]
      Table of Contents: n/a
    [%- END -%]
  </td>
  <td class="ie-only">
    [% IF item.package_toc_type %]
        [% checked = c.req.param('all') %]
        <input type="checkbox" class="print-checkbox" [% IF checked %]checked="checked"[% END %] name="[% item.id %]" file_type="pdf" id="print_[% item.id %]" value="http://[% c.req.base.host_port %][% url('/jstoc/toc_pdf', id = item.id) %]" />
    [% END %]
  </td>
</tr>
[%- printable = 0; -%]
[%- FOREACH i = item.items -%]
[%-
    j = i.is_file ? i.file : i.document;
    file_type = i.is_file ? i.file.file_format_type : i.document.derived_format; -%]
<tr class="dragTocRow">
  <td class="dragHandle"><img src="/images/icons/file.gif" alt="" class="ico" /></td>
  <td colspan="2">
    <a href="[% j.download_url || url('/folders/download', file_id = j.id) %]" target="_blank">[% j.title  %]</a>
  </td>
  <td class="ie-only">
    [% IF (i.file_id || i.document_id) && (
            file_type == 'html' || file_type == 'htm' || file_type == 'pdf' || file_type == 'word' || file_type == 'excel' || file_type == 'doc' || file_type == 'xls'
            || file_type == 'rtf' || file_type == 'txt' || file_type == 'text' || file_type == 'csv'
            || file_type == 'jpg' || file_type == 'jpeg' || file_type == 'gif' || file_type == 'png' || file_type == 'tif' || file_type == 'tiff'
            || file_type == 'xml'
    ) %]
        [%  printable = printable + 1;
            checked = c.req.param('all') ? 1 : 0;
        IF !checked;
            IF i.document_id && c.req.param('document_id') && i.document_id == c.req.param('document_id');
                checked = 1;
            END;
            IF i.document_id && c.req.param('product_id') && i.document_id.product_id == c.req.param('product_id');
                checked = 1;
            END;
            IF i.file_id && c.req.param('file_id') && i.file_id == c.req.param('file_id');
                checked = 1;
            END;
        END;
     %]
        <input type="checkbox" class="print-checkbox" [% IF checked %]checked="checked"[% END %] name="[% i.package_item_id %]" file_type="[% file_type %]" id="print_[% i.package_item_id %]" value="[% IF i.file.file_id %]http://[% c.req.base.host_port %]/[% END %][% j.download_url %]" />
    [% END %]
  </td>
</tr>
[%- END -%]
[% IF printable > 0 %]
<tr class="ie-only nodrop">
  <td class="no-border">&nbsp;</td>
  <td class="no-border">&nbsp;</td>
  <td class="no-border" style="text-align:right;">
    All:
  </td>
  <td class="no-border">
      <input type="checkbox" name="check_all" id="check_all" />
  </td>
</tr>
[% END %]
</table>
[%- END -%]

<div>
    <input class="ie-only" type="button" name="print" value="Print" onClick="return printPackage();"/>
    <input name="file_id" id="file_id" type="hidden" value="[% item.file_id %]" />
</div>

<script type="text/javascript" language="javascript">
;(function($) {
    $(document).ready(function() {
        $('table#tablePrintItems').tableDnD({
                dragHandle: "dragHandle",
                onDragClass: "dragTocRow"
        });

        [% IF force_print %]
            printPackage();
        [% END %]
        $("#check_all").click(function(){
            $(".print-checkbox").attr('checked', $(this).is(':checked'));
        }).attr('checked', ($(".print-checkbox").size() == $(".print-checkbox[checked]").size()));
    });
})(jQuery);
</script>


[% IF product.leed_attributes %]<tr class="green-data"><th>Green Data:</th>
	<td>
		<table class="t-basic t-vert t-prod-details">
				[% FOREACH attribute = product.leed_attributes %]
				<tr>
					<td>[% attribute.attribute_id.attribute_name %]</td>
					<td>
					[% IF attribute.attribute_id.attribute_id == 'leed_credits' %]
						[% FOREACH credit = product.leed_credits %]
							<a href="/leed-credits/view?leed_credit_id=[% credit.shortname %]">[% credit.leed_credit_id %]</a> 
						[% END %]
					[% ELSE %]
						[% attribute.val %]
					[% END %]
					</td>
				</tr>
				[% END %]
		</table>
	</td>
[% END %]
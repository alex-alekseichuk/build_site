[%-
    USE url('/' _ c.req.path, c.req.params)
-%]
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>

<title>[%- page_title -%]</title>

<!-- Meta Tags -->
<meta http-equiv="content-type" content="application/xhtml+xml; charset=utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=EmulateIE7" />
<meta name="robots" content="index, follow" />


<meta name="description" content="" />
<meta name="keywords" content="" />
<meta name="author" content="" />

<!-- don't cache this page -->
<meta http-equiv="Cache-Control" content="no-cache,post-check=0,pre-check=0,no-cache" />
<meta http-equiv="Pragma" content="no-cache" />
<meta http-equiv="Expires" content="Thu,01Dec199416:00:00GMT" />


<!-- Favicon -->

<!--<link rel="shortcut icon" href="" />-->

<script type="text/javascript">
[% IF c.current_package && c.session.current_package_json %]
var currentPackageJSON = [% c.session.current_package_json %];
[% END %]

var undeliveredMessages = new Array([% FOREACH m = c.session.undelivered_messages_list %]'[% m %]'[% ',' UNLESS loop.last %][% END %]);
</script>

[% pack = '.pack' IF c.bst_config("use_compressed_static") %]

<!-- CSS -->
[% IF pack %]
<link rel="stylesheet" href="/css/style.pack.css" media="all" type="text/css" />
<link rel="stylesheet" href="/css/common.pack.css" type="text/css" />
<!--[if IE]><link rel="stylesheet" type="text/css" media="all" href="/css/ie.pack.css" /><![endif]-->
[% ELSE %]
<link rel="stylesheet" href="/css/style.css" media="all" type="text/css" />
<link rel="stylesheet" type="text/css" href="/css/jquery-ui-themeroller.css" />
<link rel="stylesheet" type="text/css" href="/css/jquery-tablesorter.css" />
<link rel="stylesheet" type="text/css" href="/css/sidebar.css" />
<!--[if IE]><link rel="stylesheet" type="text/css" media="all" href="/css/ie.css" /><![endif]-->
[% END %]

[% IF custom_css %]
	<link rel="stylesheet" type="text/css" href="/css/[% custom_css %].css" />
[% END %]

[% IF no_sidebar %]
<link rel="stylesheet" type="text/css" href="/css/no-sidebar[% pack %].css" />
[% END %]

[% UNLESS c.bst_config("green_features_enable") -%]
<link rel="stylesheet" type="text/css" href="/css/hidegreen[% pack %].css" />
[% END %]


<!-- JavaScript -->
[%- IF pack -%]
<script src="/js/common.pack.js" type="text/javascript"></script>
[% UNLESS no_sidebar %]<script src="/js/sidebar.pack.js" type="text/javascript"></script>[% END %]
[%- ELSE -%]
<script src="/js/jquery.js" type="text/javascript"></script>
<script src="/js/jquery.bgiframe.min.js" type="text/javascript"></script>
<script src="/js/jquery-ui.js" type="text/javascript"></script>
<script src="/js/jquery.tooltip.js" type="text/javascript"></script>
<script src="/js/jquery.form.js" type="text/javascript"></script>
<script src="/js/jquery.namespace.js" type="text/javascript"></script>
<script src="/js/jquery.tmpl.1.1.1.js" type="text/javascript"></script>
<script src="/js/bs.common.js" type="text/javascript"></script>
<script src="/js/bs.common.templates.js" type="text/javascript"></script>
<script src="/js/jquery.tablesorter.js" type="text/javascript"></script>
<script src="/js/tablesorter.js" type="text/javascript"></script>
[% UNLESS no_sidebar %]
<script src="/js/sidebar.js" type="text/javascript"></script>
<script src="/js/sidebar.templates.js" type="text/javascript"></script>
[% END %]
[%- END -%]

[% IF no_sidebar %]
<script type="text/javascript">
		if ("undefined" != typeof currentPackageJSON) {
			$.bs.current_package( currentPackageJSON );
		}
</script>
[% END %]
<!--[if IE]><script src="/js/jquery.pngFix.pack.js" type="text/javascript"></script><![endif]-->
</head>
<body>

<div class="l-meta">
    <div class="l-header">
        <h1 class="logo"><a href="/"><img src="/images/layout/logo.png" alt="BuildSite" /></a></h1>
        <div class="subtitle">
            <span>[% c.user.given_name _ " " _ c.user.family_name %]</span> |
                    <span>[% c.user.primary_location.location_fullname %]</span> |
                    <span>[% c.user.primary_location.location_phone %]</span>
            [% IF c.user.primary_location.account.sponsor %]<span>sponsored by [% c.user.primary_location.account.sponsor.name %]</span>[% END %]
        </div>
        <div class="hidden" id="notice-undelivered"><!-- --></div>
        <ul class="b-user-nav">
            <li class="logout"><a href="/logout">Logout</a></li>
            <li class="prefs"><a href="/settings">Preferences</a></li>
            <li class="help"><a href="/help">Help</a></li>
        </ul>
        <div class="l-header-nav">
            <ul class="b-global-nav">
                <li><span>Browse Content</span>
                    <ul>
                        <li><a href="/companies/list">Manufacturers</a></li>
                        <li><a href="/product/list">Product Name</a></li>
                        <li><a href="/categories/list">Product Category</a></li>
                        <li><a href="/search/?where=astm">ASTM</a></li>
                        <li><a href="/jobsite/">Jobsite MSDS</a></li>
                        <li><a href="/leed-credits/list">LEED Credit</a></li>
                    </ul>
                </li>
                <li><span>Message Center</span>
                    <ul>
                        <li><a href="/messages/blank">New Message</a></li>
                        [%- IF has_current_message -%]<li><a href="/messages/current">Current Message</a></li>[%- END -%]
                        <li><a href="/messages/list">All Messages</a></li>
                        <li><a href="/contacts/person/list">Contacts</a></li>
                        <li><a href="/contacts/company/list">Companies</a></li>
                    </ul>
                </li>
                <li><span>Packages &amp; Files</span>
                    <ul>
                        <li><a href="/jspackage/blank" class="destructive">New Package</a></li>
                                      [%- IF current_package -%]<li><a href="/folders/edit?file_id=[%current_package.package_id%]" id="current-package-menu-link">Current Package</a></li>[%- END -%]
                        <li><a href="/folders/list?scope=account">Company Files</a></li>
                        <li><a href="/folders/list?scope=location">Location Files</a></li>
                        <li><a href="/folders/list?scope=user">Personal Files</a></li>
                        <li><a href="/folders/list?scope=all">All Files</a></li>
                        <li><a href="/folders/upload">Upload File</a></li>
                    </ul>
                </li>
            </ul><!--b-global-nav-->
            <div class="b-search"><div class="l"><div class="r">
                <form id="form_search" action="/search/" method="get">
                    <input type="hidden" name="term" value="and" />
                    <input type="hidden" name="mfg_my_all" value="my" />
                    <table>
                        <tr>
                            <td class="td-header">
                                <h3>Search</h3>
                                <select name="where" id="where">
                                    <option value="pname"[% ' selected="selected"' IF c.req.param('where') == "pname" %]>Product Name</option>
                                    <option value="manufacturer"[% ' selected="selected"' IF c.req.param('where') == "manufacturer" %]>Manufacturer</option>
                                    <option value="astm"[% ' selected="selected"' IF c.req.param('where') == "astm" %]>Product ASTM</option>
                                    <option value="category"[% ' selected="selected"' IF c.req.param('where') == "category" %]>Product Category</option>
                                    <option value="green">Green Data</option>
                                </select>
                            </td>
                            <td class="td-q"><input type="text" name="q" value="[% c.req.params.q.replace('"', '&quot;') %]" /></td>
                            <td class="td-button"><input type="submit" class="submit" value="SEARCH" /></td>
                        </tr>
                    </table>
                </form>
            </div></div></div><!---b-search-->
        </div><!--l-header-nav-->
    </div><!--l-header-->


    <div class="l-body">
        [%- PROCESS breadcrumbs.tt IF crumbs.size -%]

        <div class="l-section"><div class="h-section">
            [% IF caption %]
            <h1 class="b-block-head">
                <i class="ico ico-[% caption_class || "tool" %]"></i>
                [% caption %]
            </h1>
            [% END %]
            <div class="b-block[% " has-caption" IF caption %]">

                        [%- PROCESS error.tt error IF error.status -%]
                        [% content %]

            </div><!--b-block-->
        </div></div><!--l-section-->

        <div class="l-sidebar" id="bsSidebar">
            <div id="placement_sidebar"></div>
        </div>
    </div><!--body-->

		[% INCLUDE "page_footer.tt" %]
</div><!--l-meta-->
[% INCLUDE "user_tracking.tt" %]
</body>
</html>
